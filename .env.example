# ============ DATABASE ============
DATABASE_URL=postgresql+asyncpg://sama4:sama4_dev@localhost:5432/sama4
# For Supabase (production):
# DATABASE_URL=postgresql+asyncpg://user:pass@db.xxx.supabase.co:5432/postgres
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# ============ CACHE (Redis) ============
REDIS_URL=redis://localhost:6379
# For Upstash (production):
# UPSTASH_REDIS_URL=https://xxx.upstash.io
# UPSTASH_REDIS_TOKEN=your-upstash-token

# ============ VECTOR STORE + EMBEDDINGS (Pinecone Inference) ============
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX=sama4-articles-v2      # auto-created (1024-d) if missing
PINECONE_EMBED_MODEL=llama-text-embed-v2

# ============ LLM (Claude) ============
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low

# ============ MIROFISH (prediction engine) ============
MIROFISH_URL=http://localhost:5001
MIROFISH_ENABLED=true
MIROFISH_AUTO_SIMULATE=true
MIROFISH_IMPACT_THRESHOLD=5
MIROFISH_DEFAULT_AGENTS=500
MIROFISH_DEFAULT_ROUNDS=30

# ============ MONITORING ============
SENTRY_DSN=https://xxx@sentry.io/xxx

# ============ APP CONFIG ============
ENVIRONMENT=development
LOG_LEVEL=DEBUG
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:3000"]

# ============ FRONTEND ============
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SENTRY_DSN=
