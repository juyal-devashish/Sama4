# Copy to .env (repo root or backend/) for local development. Never commit .env.
# Every setting is defined in backend/app/config.py; anything omitted uses its default.

# ---- App -------------------------------------------------------------------
ENVIRONMENT=development            # "production" on Railway
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]
SCHEDULER_ENABLED=true             # run news ingestion every 30 min in-process
ADMIN_SECRET=change-me             # X-Admin-Secret for /api/v1/admin/*; the default is refused in production

# ---- Database / cache --------------------------------------------------------
# `make infra-up` starts these. For zero-setup dev use: sqlite+aiosqlite:///./dev.db
DATABASE_URL=postgresql+asyncpg://sama4:sama4_dev@localhost:5432/sama4
REDIS_URL=redis://localhost:6379   # empty = caching disabled

# ---- Claude (all text generation) -----------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low               # default effort for high-volume calls

# ---- Pinecone (vector index + embeddings via Pinecone Inference) -----------------
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=us-east-1     # region for the auto-created serverless index
PINECONE_INDEX=sama4-articles-v2
PINECONE_EMBED_MODEL=llama-text-embed-v2

# ---- MiroFish prediction engine (optional separate service) -----------------------
MIROFISH_ENABLED=false
MIROFISH_URL=http://localhost:5001
MIROFISH_AUTO_SIMULATE=false

# ---- Monitoring ---------------------------------------------------------------
SENTRY_DSN=

# ---- Frontend (frontend/.env.local) -------------------------------------------
# NEXT_PUBLIC_API_URL=http://localhost:8000
